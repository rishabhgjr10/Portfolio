# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Password for the owner-only resume upload page at /admin/resume. Use a long random string.
RESUME_ADMIN_PASSWORD=

# Added automatically when you connect a Vercel Blob store to the project (Storage → Create → Blob).
# Without it, /resume serves public/RishabhGurjar.pdf.
BLOB_READ_WRITE_TOKEN=

# Public URL of the portfolio, used for link-preview (Open Graph) images.
NEXT_PUBLIC_SITE_URL=https://rishabhgjr.vercel.app
